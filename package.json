{
  "type": "module",
  "name": "context-aware-winston-logging",
  "version": "2.0.0-SNAPSHOT",
  "description": "A derived winston logger with configurable context through middleware",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "preversion": "npm run build",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LostAndFoundAgain/Context-Aware-Logging.git"
  },
  "keywords": [
    "Context",
    "Logger",
    "Winston",
    "Middleware"
  ],
  "author": "N-U",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.1.1",
    "@types/uuid": "^10.0.0",
    "express": "^5.2.1",
    "prettier": "^2.8.8",
    "typescript": "^5.0.4"
  },
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "uuidv4": "^6.2.13",
    "winston": "^3.19.0"
  }
}
