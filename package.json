{
  "name": "context-aware-winston-logging",
  "version": "1.0.2",
  "description": "A derived winston logger with configurable context through middleware",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LostAndFoundAgain/Context-Aware-Logging.git"
  },
  "keywords": [
    "Context",
    "Logger",
    "Winston",
    "Middleware"
  ],
  "author": "N-U",
  "license": "ISC",
  "peerDependencies": {
    "winston": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^9.4.0",
    "@types/jest": "^29.5.1",
    "@types/node": "^20.1.1",
    "@types/uuid": "^3.4.4",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.0.4"
  },
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "uuidv4": "^6.2.13"
  }
}
